# ---------------------------------------------------------------------------
# FoundersBee environment
# Copy to .env.local for local development. Everything here is optional in dev:
# the catalog is content-as-code, so the site browses fine with an empty file.
# ---------------------------------------------------------------------------

# Public base URL, used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (libSQL / SQLite) --------------------------------------------
# Local dev defaults to a file at .data/foundersbee.db when unset.
# Production: a Turso database URL + token.
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN=""

# --- Auth -------------------------------------------------------------------
# Required once you enable sign-in. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# When RESEND_API_KEY is unset, magic links are written to .data/last-magic-link.txt
# and printed to the server log instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="FoundersBee <hello@foundersbee.com>"
# Where partner submissions are sent.
PARTNER_INBOX="partners@foundersbee.com"

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# --- Redemption secrets -----------------------------------------------------
# The catalog in content/deals/*.md carries placeholders, never real codes.
# Real codes/links are injected here as JSON keyed by deal slug:
#   {"some-deal":{"code":"REALCODE","url":"https://..."}}
REDEMPTIONS_JSON=""
